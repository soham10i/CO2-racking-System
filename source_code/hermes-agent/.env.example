# Copy to .env (git-ignored) and fill in. Leave MERCURY_API_KEY empty to use the local mock.
MERCURY_API_KEY=
MERCURY_BASE_URL=https://api.inceptionlabs.ai/v1
MERCURY_MODEL=mercury-2
# Bearer token clients must send to the agent's API. Generate: openssl rand -hex 32
API_SERVER_KEY=change-me-local-dev
