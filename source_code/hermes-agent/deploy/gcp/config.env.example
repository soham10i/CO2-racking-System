# Copy to deploy/gcp/config.env (git-ignored) and edit. No secrets in this file.
GCP_PROJECT_ID=your-project-id
GCP_REGION=europe-west3          # Frankfurt; Cloud Run + Artifact Registry + Cloud Build all available
AR_REPO=hermes
SERVICE=hermes-agent
RUNTIME_SA=hermes-agent-run      # identity the Cloud Run service runs as
DEPLOYER_SA=hermes-agent-deploy  # identity Cloud Build / GitHub Actions deploy as
MIN_INSTANCES=0                  # 0 = scale to zero (cheapest; cold starts ~10-30s)
MAX_INSTANCES=2                  # hard cap on cost and on concurrent Mercury spend
# Only for GitHub Actions Workload Identity Federation:
GITHUB_REPO=owner/CO2-racking-System
WIF_POOL=github
WIF_PROVIDER=github-oidc
