{
  "name": "CO2 Tracker",
  "short_name": "CO2",
  "description": "Log trips, meals and energy and see your carbon footprint.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f2f2f7",
  "theme_color": "#1d9a43",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/favicon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "shortcuts": [
    { "name": "Quick log", "short_name": "Log", "url": "/?quicklog=1", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Activity log", "short_name": "History", "url": "/log", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] }
  ]
}
