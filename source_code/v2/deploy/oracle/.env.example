# Copy to .env on the VM (chmod 600) and fill in. Never commit .env.

# Public hostname pointing at the VM's public IP (A record). Without a domain you can use
# <ip-with-dashes>.sslip.io, e.g. 141-147-1-2.sslip.io.
DOMAIN=co2.example.com
ACME_EMAIL=you@example.com

# openssl rand -base64 33   /   openssl rand -base64 48
DB_PASSWORD=
JWT_SECRET=

# OCI Email Delivery (Console > Developer Services > Email Delivery). SMTP credentials come from
# Identity > Users > your user > SMTP Credentials. The From address must be an Approved Sender.
MAIL_HOST=smtp.email.eu-frankfurt-1.oci.oraclecloud.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
APP_MAIL_FROM=no-reply@co2.example.com

# Backups to OCI Object Storage via its S3-compatible API (see backup.sh).
# Namespace: Console > Tenancy details > Object storage namespace. Keys: your user > Customer Secret Keys.
OCI_REGION=eu-frankfurt-1
OCI_NAMESPACE=
OCI_BUCKET=co2tracker-backups
OCI_S3_ACCESS_KEY=
OCI_S3_SECRET_KEY=
BACKUP_KEEP_LOCAL_DAYS=7
