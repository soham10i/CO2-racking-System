# Copy to .env and fill in. Never commit .env.
DB_PASSWORD=change-me
# At least 32 characters, e.g. `openssl rand -base64 48`
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
# Set to true when served over HTTPS
COOKIE_SECURE=false

# Optional: comma-separated emails that get the admin factor console (matched case-insensitively)
# APP_ADMIN_EMAILS=
# Sign in with Google: OAuth client id (type "Web application") from console.cloud.google.com.
# Add your site origin (e.g. http://localhost:8081) under "Authorized JavaScript origins". No secret needed.
# GOOGLE_CLIENT_ID=
# Serve the OpenAPI spec at /api/v1/docs (leave off in production).
# API_DOCS_ENABLED=false
# Optional: web push. Generate a P-256 key pair once, e.g. `npx web-push generate-vapid-keys`,
# and keep the private key only here. Push stays off while these are empty.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# Nexus assistant (Hermes agent + Mercury LLM). HERMES_API_KEY is shared by api and hermes: openssl rand -hex 32
HERMES_API_KEY=
# Leave both empty to use the local mock; for real answers set your Inception key and https://api.inceptionlabs.ai/v1
MERCURY_API_KEY=
MERCURY_BASE_URL=
MERCURY_MODEL=mercury-3

# Supabase Postgres (optional). Use the Session pooler string from Supabase > Connect (IPv4).
SUPABASE_DB_URL=
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=
